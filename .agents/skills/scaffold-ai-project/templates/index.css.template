@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --brand: 226 62% 40%;
    --background: 0 0% 100%;
    --foreground: 240 10% 15%;

    --card: 0 0% 100%;
    --card-foreground: 240 10% 15%;

    --popover: 0 0% 100%;
    --popover-foreground: 240 10% 15%;

    --primary: 226 62% 40%;
    --primary-foreground: 0 0% 100%;
    --primary-hover: 225 63% 33%;
    --primary-light: 224 100% 96%;
    --primary-dark: 225 63% 33%;

    --secondary: 240 5% 96%;
    --secondary-foreground: 240 10% 30%;

    --muted: 240 5% 96%;
    --muted-foreground: 240 4% 46%;

    --accent: 240 5% 96%;
    --accent-foreground: 240 10% 15%;

    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 100%;

    --success: 142 71% 45%;
    --success-foreground: 142 71% 95%;

    --warning: 37 100% 55%;
    --warning-foreground: 37 100% 95%;

    --info: 217 91% 60%;
    --inactive: 215 16% 47%;
    --experimental: 262 83% 58%;

    --border: 240 6% 90%;
    --input: 240 6% 90%;
    --ring: 226 62% 40%;

    --radius: 0.5rem;

    --sidebar-background: 240 5% 96%;
    --sidebar-foreground: 240 4% 46%;
    --sidebar-primary: 226 62% 40%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 240 5% 92%;
    --sidebar-accent-foreground: 240 10% 15%;
    --sidebar-border: 240 6% 90%;
    --sidebar-ring: 226 62% 40%;
  }

  .dark {
    --brand: 226 70% 55%;
    --background: 240 10% 4%;
    --foreground: 0 0% 98%;

    --card: 240 10% 6%;
    --card-foreground: 0 0% 98%;

    --popover: 240 10% 6%;
    --popover-foreground: 0 0% 98%;

    --primary: 226 70% 55%;
    --primary-foreground: 0 0% 100%;
    --primary-hover: 226 70% 65%;
    --primary-light: 226 50% 20%;
    --primary-dark: 226 70% 45%;

    --secondary: 240 4% 16%;
    --secondary-foreground: 0 0% 98%;

    --muted: 240 4% 16%;
    --muted-foreground: 240 5% 65%;

    --accent: 240 4% 16%;
    --accent-foreground: 0 0% 98%;

    --destructive: 0 63% 31%;
    --destructive-foreground: 0 0% 98%;

    --success: 142 71% 35%;
    --success-foreground: 142 71% 95%;

    --warning: 37 90% 45%;
    --warning-foreground: 37 100% 95%;

    --info: 217 91% 50%;
    --inactive: 215 16% 37%;
    --experimental: 262 83% 48%;

    --border: 240 4% 16%;
    --input: 240 4% 16%;
    --ring: 226 70% 55%;

    --sidebar-background: 240 10% 5%;
    --sidebar-foreground: 240 5% 65%;
    --sidebar-primary: 226 70% 55%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 240 4% 12%;
    --sidebar-accent-foreground: 0 0% 98%;
    --sidebar-border: 240 4% 14%;
    --sidebar-ring: 226 70% 55%;
  }
}
